rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function memberExists() {
      return signedIn() && exists(memberPath());
    }

    function me() {
      return get(memberPath()).data;
    }

    // ใช้สำหรับอ่านโปรไฟล์/เปลี่ยนรหัสครั้งแรกเท่านั้น
    function enabledMember() {
      return memberExists() && me().get('status', '') == 'active';
    }

    // Backward-compatible gate:
    // สมาชิกเก่าบางบัญชีไม่มี field mustChangePassword/passwordChangePending
    // จึงต้องใช้ Map.get(default) เพื่อไม่ให้ Rules โยน error และบล็อกทั้งบัญชี
    function active() {
      // passwordChangePending เป็นเพียงสถานะระหว่างเปลี่ยนรหัส และต้องไม่ล็อกบัญชี
      // เมื่อ mustChangePassword ถูกปิดแล้ว (รองรับบัญชีเก่า/สถานะค้างจากการอัปเดต)
      return enabledMember()
        && me().get('mustChangePassword', false) != true;
    }

    function roleIs(value) {
      return active() && me().get('role', 'staff') == value;
    }

    function admin() {
      return roleIs('admin');
    }

    function manager() {
      return roleIs('manager') || admin();
    }

    function captain() {
      return roleIs('captain');
    }

    function manageProducts() {
      return captain() || manager()
        || (active() && me().get('permissions', {}).get('canManageProducts', false) == true);
    }

    function adjustStock() {
      return captain() || manager()
        || (active() && me().get('permissions', {}).get('canAdjustStock', false) == true);
    }

    function approver() {
      return captain()
        || manager()
        || (active() && me().get('permissions', {}).get('canApprove', false) == true);
    }

    function canAssignApprovers() {
      return captain() || manager();
    }

    function validProductDocument(data) {
      return data.get('name', '') is string
        && data.get('stock', -1) is number
        && data.get('stock', -1) >= 0
        && data.get('min', 0) is number
        && data.get('min', 0) >= 0;
    }

    function productPath(productId) {
      return /databases/$(database)/documents/theviewWorkspaces/main/products/$(productId);
    }

    function validPendingApprovalShape(data) {
      return data.get('status', '') == 'pending'
        && data.get('qty', 0) is number
        && data.get('qty', 0) > 0
        && (data.get('type', '') == 'in' || data.get('type', '') == 'out')
        && data.get('productId', '') is string
        && data.get('productId', '') != '';
    }

    function validPendingApprovalProduct(data) {
      return exists(productPath(data.get('productId', '')))
        && get(productPath(data.get('productId', ''))).data.get('trashed', false) != true
        && get(productPath(data.get('productId', ''))).data.get('archived', false) != true
        && get(productPath(data.get('productId', ''))).data.get('stock', -1) is number
        && get(productPath(data.get('productId', ''))).data.get('stock', -1) >= 0
        && (
          data.get('type', '') == 'in'
          || data.get('qty', 0) <= get(productPath(data.get('productId', ''))).data.stock
        );
    }

    function validPendingApproval(data) {
      return validPendingApprovalShape(data)
        && validPendingApprovalProduct(data);
    }

    match /members/{uid} {
      // เจ้าของบัญชีต้องอ่านโปรไฟล์ตัวเองได้ แม้ยังติด First Password Gate
      allow get: if enabledMember() && (
        request.auth.uid == uid || captain() || manager()
      );

      allow list: if captain() || manager();
      allow create: if false;
      // Factory Reset: Admin ลบโปรไฟล์สมาชิกคนอื่นได้ แต่ลบบัญชีตัวเองไม่ได้
      allow delete: if admin() && request.auth.uid != uid;

      // Admin จัดการสมาชิกได้ แต่ต้องเป็นบัญชีที่ผ่าน gate แล้ว
      allow update: if admin();

      // เจ้าของบัญชีแก้ได้เฉพาะข้อมูลส่วนตัวเท่านั้น; password gate แก้ได้จาก Admin SDK/Cloud Function เท่านั้น
      allow update: if enabledMember()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName',
          'lastName',
          'displayName',
          'position',
          'department',
          'phone',
          'photoURL',
          'profileUpdatedAt',
          'lastLoginAt'
        ]);

      allow update: if canAssignApprovers()
        && resource.data.role == 'staff'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'permissions',
          'approvalAssignedBy',
          'approvalAssignedAt'
        ]);
    }

    match /theviewWorkspaces/main/products/{id} {
      allow read: if active();

      // สร้างสินค้าได้เมื่อยอดเริ่มต้นและจุดเตือนไม่ติดลบ
      allow create: if manageProducts() && validProductDocument(request.resource.data);
      allow delete: if manageProducts();
      allow update: if (admin() && validProductDocument(request.resource.data))
        || (manageProducts()
          && validProductDocument(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','sku','skuKey','category','unit','min','hasExpiry','expiryDate','expiryReminderDays','expiryAlertDays','archived','trashed','trashedAt','photo','photoPath','updatedAt'
          ]))
        || (adjustStock()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stock','updatedAt','lastAdjustedAt','lastAdjustedBy','lastAdjustedReason'
          ])
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0)
        || (approver()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stock','updatedAt','lastAdjustedAt','lastAdjustedBy','lastAdjustedReason'
          ])
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0);
    }

    match /theviewWorkspaces/main/skuRegistry/{id} {
      allow read: if active();
      allow create, update, delete: if manageProducts();
    }

    match /theviewWorkspaces/main/approvals/{id} {
      allow create: if validPendingApproval(request.resource.data)
        && (admin() || (active()
          && request.resource.data.submittedByUid == request.auth.uid));

      allow read: if approver()
        || (active() && resource.data.submittedByUid == request.auth.uid);

      allow update: if validPendingApproval(request.resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.submittedByUid == resource.data.submittedByUid
        && request.resource.data.productId == resource.data.productId
        && (
          approver()
          || (
            active()
            && resource.data.submittedByUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'qty','type','location','eventId','logId','updatedAt','updatedByUid','updatedByName'
            ])
          )
        );

      allow delete: if approver()
        || (
          active()
          && resource.data.submittedByUid == request.auth.uid
          && resource.data.status == 'pending'
        );
    }

    match /theviewWorkspaces/main/logs/{id} {
      allow create: if active() && request.resource.data.actorUid == request.auth.uid;
      allow read: if active();

      allow update: if approver()
        || (
          active()
          && resource.data.actorUid == request.auth.uid
          && resource.data.action == 'ส่งตรวจ'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'action','detail','qty','unit','location','moveType','time','updatedAt','cancelledAt'
          ])
          && (
            request.resource.data.action == 'ส่งตรวจ'
            || request.resource.data.action == 'ยกเลิก'
          )
        );

      allow delete: if admin();
    }

    match /theviewWorkspaces/main/auditLogs/{id} {
      allow create: if active()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.immutable == true;
      allow read: if manageProducts();
      allow update: if false;
      allow delete: if admin();
    }



    match /theviewWorkspaces/main/notifications/{id} {
      allow read: if active();
      allow create: if active();
      allow update: if active() && (
        admin() || resource.data.userUid == request.auth.uid
      );
      allow delete: if admin()
        || (active() && resource.data.userUid == request.auth.uid);
    }

    match /theviewWorkspaces/main/settings/{id} {
      allow read: if active();
      allow create, update, delete: if admin();
    }

    // เอกสาร workspace แม่ ใช้ลบเฉพาะตอน Factory Reset
    match /theviewWorkspaces/main {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
